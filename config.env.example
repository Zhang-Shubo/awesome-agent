# awesome-agent 全局配置模板
# 拷贝为 config.env 后填真实值(config.env 已被 gitignore,永不入库)。
# 推荐直接运行 ./init.sh,交互式生成本文件。

# ── 基础 ────────────────────────────────────────────────
# agent 根目录(projects / memory / skills 所在,见 docs/07)
AGENT_ROOT="$HOME/agent"
# 你的域名(DNS 已托管到 Cloudflare)
DOMAIN=""

# ── GitHub ─────────────────────────────────────────────
GIT_USER=""
# Personal Access Token,scope 建议:repo(建仓/推送)。只存在于本机。
GIT_TOKEN=""
# 记忆仓库与通用 skill 仓库(init 时若不存在会引导创建)
MEMORY_REPO=""      # 例: git@github.com:you/agent-memory.git
SKILLS_REPO=""      # 例: git@github.com:you/agent-skills.git

# ── Cloudflare ─────────────────────────────────────────
# cloudflared tunnel login 走浏览器授权,不需要在此存 token;
# 如需 API 操作(R2 / DNS / Access),再填以下两项:
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
# 面板对外子域名(init 会提示,如 panel.example.com)
PANEL_HOST=""

# ── 面板 ────────────────────────────────────────────────
PANEL_PORT="8787"
# 面板背景: 留空为 aurora 动态光斑;填 wallpapers/ 下的文件名(如 3.jpg)则用壁纸。
# 页面底部也有切换器,选择记在浏览器本地并优先生效。
WALLPAPER=""
