# 拷成 config.env 并填入真实值。config.env 已被 .gitignore 排除,永不入库。

# --- 服务 ---
HOST=127.0.0.1          # 铁律:只听本地,对外走隧道
PORT=8900

# --- 知识库 ---
VAULT_DIR=~/Documents/vault

# --- Cloudflare R2(统一口径,所有项目同名)---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://r2.example.com
R2_KEY_PREFIX=

# --- 模型三级后端(按优先级,都不设则本机 claude -p)---
# ANTHROPIC_API_KEY=      # 1. 直连 API(服务器首选)
# CLAUDE_SSH_HOST=        # 2. 借远程机 Claude Code 登录态
CLAUDE_MODEL=claude-fable-5   # claude -p 显式指定模型,默认模型可能偏旧

# --- 通知(可选)---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- 写保护(可选;不设则依赖 127.0.0.1 + Access 兜底)---
# WRITE_TOKEN=
