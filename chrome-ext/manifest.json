{
  "manifest_version": 3,
  "name": "awesome-agent 面板",
  "description": "Chrome 启动时自动打开 awesome-agent 面板;点工具栏图标随时回到面板。",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "打开 awesome-agent 面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["storage", "tabs"]
}
